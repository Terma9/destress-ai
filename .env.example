# Copy to .env and fill in from Supabase → Project Settings → API.
# Both values are public by design (they ship inside the app); data is protected by Row Level Security.
# Never put the Supabase secret key or any LLM API key here.
EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
